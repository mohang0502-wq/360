# ── Database (MySQL 8) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=360_retouching

# ── API server ──────────────────────────────────────────────────────
PORT=4000
# Set to "production" on the server. In production the API refuses to start
# without a strong JWT_SECRET and hides internal error details.
NODE_ENV=development
# Random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of site origins allowed to call the API.
# Leave empty only in development.
CORS_ORIGIN=

# ── Contact form email notifications (optional) ─────────────────────
# Without these, enquiries are still saved and visible in Admin → Inquiries.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=

# ── Frontend (read at build time by Vite) ───────────────────────────
# Public URL of the API, e.g. https://api.360retouching.com
VITE_API_URL=http://localhost:4000
