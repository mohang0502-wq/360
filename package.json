{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/api.js",
    "seed": "npx tsx server/seed.mjs",
    "migrate:categories": "node server/migrate-categories.mjs",
    "migrate:site-settings": "node server/migrate-site-settings.mjs",
    "migrate:image-library": "node server/migrate-image-library.mjs",
    "import:image-library": "node server/import-image-library.mjs",
    "migrate:image-urls": "node server/migrate-image-urls.mjs",
    "test:api": "node --test \"server/tests/*.test.mjs\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.39.0",
    "multer": "^2.0.0",
    "mysql2": "^3.5.2",
    "nodemailer": "^10.0.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
